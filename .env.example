# Copy to .env (optional). Every value has a sensible default in cypher/config.py.

# Where trained weights live
CYPHER_MODELS_DIR=models
# SQLite file holding the relational graph, audit log and slang cache
CYPHER_DB=data/cypher.db
# Hugging Face encoder used by the hybrid model
CYPHER_ENCODER=distilbert-base-multilingual-cased

# Layer 2 zero-tolerance threshold and the "clean" cut-off
CYPHER_TAU_STRICT=0.85
CYPHER_TAU_CLEAN=0.30
# Layer 3 EMA memory factor (0.8 - 0.95 in the paper)
CYPHER_EMA_ALPHA=0.85
# Layer 1 slang time-to-live in days
CYPHER_SLANG_TTL_DAYS=60

# Frontend: only needed if the API is not on the same origin
# VITE_API_URL=http://127.0.0.1:8000

# Telegram bot: token from @BotFather (see README -> Telegram bot)
TELEGRAM_BOT_TOKEN=
# Where the bot finds the CYPHER API
CYPHER_API_URL=http://127.0.0.1:8000
